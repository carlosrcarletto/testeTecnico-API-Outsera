{
  "name": "testes-api-serverest",
  "version": "1.0.0",
  "description": "Testes automatizados de API (ServeRest) com Playwright: cenários positivos e negativos, validação de status, headers, corpo e contrato.",
  "private": true,
  "scripts": {
    "test": "playwright test --project=local",
    "test:positivos": "playwright test --project=local --grep @positivo",
    "test:negativos": "playwright test --project=local --grep @negativo",
    "test:remoto": "playwright test --project=remoto",
    "relatorio": "playwright show-report relatorio/html"
  },
  "allowScripts": {
    "@scarf/scarf": false
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "serverest": "^3.2.2"
  }
}
